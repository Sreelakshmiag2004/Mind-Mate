# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is gitignored.

# --- Environment ---
# One of: development, test, production
ENVIRONMENT=development

# --- Database ---
# PostgreSQL connection string used by SQLAlchemy/Alembic.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://mindmate:mindmate@localhost:5432/mindmate

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER reuse this placeholder in a real deployment.
JWT_SECRET_KEY=change-me-to-a-random-64-byte-urlsafe-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Relationship invitations (Phase 4) ---
# How many days a shared comfort-person invite link/token stays acceptable.
INVITATION_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins for the Flutter app / dev tools.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Postgres container (used by docker-compose.yml only) ---
POSTGRES_USER=mindmate
POSTGRES_PASSWORD=mindmate
POSTGRES_DB=mindmate

# --- Object storage (Phase 3: media/voice notes) ---
# "s3" is the only implemented provider — it speaks the S3 API, so it works
# unchanged against MinIO (local dev) or real AWS S3 (production); only the
# values below change. Never "memory" here — that provider only exists
# inside the test suite (tests/conftest.py), not as a runtime option.
STORAGE_PROVIDER=s3
# MinIO's console/API address when run via docker-compose. Point this at
# your real bucket's regional endpoint (or omit for AWS's default) in
# production.
S3_ENDPOINT_URL=http://localhost:9000
# MinIO's well-known local-dev default credentials — change these for any
# shared/deployed environment; never reuse them past your own machine.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mindmate-media
S3_REGION=us-east-1
# Hard cap enforced server-side before any byte is written to storage.
MAX_UPLOAD_SIZE_MB=25

# --- AI / Weekly Reflection (Phase 5) ---
# "anthropic" is the only implemented provider — see
# app/services/ai/anthropic_provider.py.
AI_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/ — never commit a real one.
AI_API_KEY=change-me-to-a-real-anthropic-api-key
# Defaults to Claude Opus 5. Point this at a cheaper model (e.g.
# claude-sonnet-5) if you want to trade reflection quality for lower cost —
# this is a low-volume, at-most-once-per-user-per-week feature, so the
# default favors quality.
AI_MODEL=claude-opus-5
# Bounds a single generation request; the caller gets a clean 502 (not a
# hang) if the provider doesn't respond within this many seconds.
AI_TIMEOUT_SECONDS=20
